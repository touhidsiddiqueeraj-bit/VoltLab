{
  "name": "voltlab",
  "version": "1.3.0",
  "description": "VoltLab — motor control circuit simulator: web app + Electron shell + MCP agent layer",
  "type": "module",
  "main": "electron/main.mjs",
  "license": "MIT",
  "author": "Touhid Siddiquee Raj <touhidsiddiqueeraj@gmail.com>",
  "homepage": "https://github.com/touhidsiddiqueeraj-bit/VoltLab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/touhidsiddiqueeraj-bit/VoltLab.git"
  },
  "bugs": "https://github.com/touhidsiddiqueeraj-bit/VoltLab/issues",
  "keywords": [
    "simulator",
    "motor-control",
    "electrical",
    "iec-61082",
    "ladder-logic",
    "contactor",
    "plc",
    "electron",
    "mcp",
    "model-context-protocol",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "test": "node --test",
    "test:engine": "node --test test/dol.test.mjs",
    "test:mcp": "node test/mcp.e2e.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "package": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.voltlab.simulator",
    "productName": "VoltLab",
    "copyright": "Copyright © 2026 Touhid Siddiquee Raj",
    "directories": { "output": "dist" },
    "asar": false,
    "files": [
      "app/**/*",
      "sim/**/*",
      "electron/**/*",
      "mcp/**/*",
      "circuits/**/*",
      "server.js",
      "LICENSE",
      "README.md",
      "!**/.DS_Store"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "VoltLab-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "VoltLab-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Science",
      "desktop": {
        "Name": "VoltLab",
        "Comment": "Motor control circuit simulator"
      },
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "appImage": {
      "artifactName": "VoltLab-${version}-${arch}.AppImage"
    }
  }
}
